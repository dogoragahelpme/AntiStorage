<Window x:Class="AntiStorage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AntiStorage" WindowStartupLocation="CenterScreen"
        Width="1170" Height="790" MinWidth="880" MinHeight="650"
        Background="#F4F6F1" Foreground="#192D24" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#192D24" />
    <SolidColorBrush x:Key="Muted" Color="#4B6357" />
    <SolidColorBrush x:Key="Line" Color="#DCE5DB" />
    <SolidColorBrush x:Key="Green" Color="#1F6547" />
    <SolidColorBrush x:Key="Paper" Color="#FFFFFF" />

    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="33" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Metric" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,5,0,0" />
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Paper}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style x:Key="MetricPanel" TargetType="Border" BasedOn="{StaticResource Panel}">
      <Setter Property="Padding" Value="17,12" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="{StaticResource Paper}" />
      <Setter Property="BorderBrush" Value="#C9D8CB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="#527F62" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Frame" Property="Opacity" Value="0.78" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Frame" Property="Opacity" Value="0.48" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Green}" />
      <Setter Property="BorderBrush" Value="{StaticResource Green}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="Navigation" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#C9DACD" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Tab" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Tab" Property="Background" Value="#273F32" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Tab" Property="Background" Value="#315844" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ResultTab" TargetType="RadioButton" BasedOn="{StaticResource Navigation}">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Tab" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5">
              <ContentPresenter RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Tab" Property="Background" Value="#EDF3EA" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Tab" Property="Background" Value="#E3EEE3" />
                <Setter Property="Foreground" Value="#24543C" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#EEF3ED" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridRow">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#F0F5F0" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#DDEDDC" />
          <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PathCell" TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="ToolTip" Value="{Binding RelativePath}" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserReorderColumns" Value="False" />
      <Setter Property="CanUserResizeColumns" Value="False" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="CanUserSortColumns" Value="False" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#E7EDE6" />
      <Setter Property="RowHeight" Value="35" />
      <Setter Property="ColumnHeaderHeight" Value="35" />
      <Setter Property="EnableRowVirtualization" Value="True" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{StaticResource Paper}" />
    </Style>
  </Window.Resources>

  <Grid Background="#F4F6F1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="195" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <DockPanel Background="#1A3026" LastChildFill="False">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,25,18,33">
        <Border Background="#D1E7BC" CornerRadius="8" Width="34" Height="34">
          <Path Data="M2,14 L2,9 M7,14 L7,5 M12,14 L12,2 M1,17 L15,17" Stroke="#1A3925"
                StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="AntiStorage" Foreground="White" FontSize="18" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="9,0,0,0" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Top" Margin="12,0">
        <RadioButton Content="Storage activity" GroupName="Pages" IsChecked="True" Style="{StaticResource Navigation}" Click="ShowStorage" />
        <RadioButton Content="Temporary files" GroupName="Pages" Style="{StaticResource Navigation}" Click="ShowTemporary" Margin="0,5,0,0" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="20,0,18,23">
        <Border Height="1" Background="#3E564A" Margin="0,0,0,13" />
        <TextBlock Text="Snapshots stay on this PC" Foreground="#C0D4C8" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Column="1" Margin="26,23,26,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid x:Name="StoragePage">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
          <Button x:Name="ChooseFolderButton" Content="_Choose folder" Click="ChooseFolder" DockPanel.Dock="Right"
                  VerticalAlignment="Center" Margin="12,0,0,0" />
          <StackPanel>
            <TextBlock Text="Storage activity" Style="{StaticResource Heading}" />
            <TextBlock Text="See which files make a folder grow or shrink." Style="{StaticResource Caption}" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="16,11" Margin="0,0,0,13">
          <StackPanel>
            <DockPanel>
              <Button x:Name="ScanButton" Content="_Scan folder" Click="ScanFolder" Style="{StaticResource Primary}"
                      DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
              <StackPanel>
                <TextBlock Text="Selected folder" Style="{StaticResource Caption}" FontSize="12" />
                <TextBlock x:Name="FolderPath" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
              </StackPanel>
            </DockPanel>
            <Expander x:Name="Exclusions" Header="Folder exclusions" Foreground="{StaticResource Muted}" Margin="0,8,0,0">
              <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Top">
                  <Button x:Name="AddExclusionButton" Content="_Add" Click="AddExclusion" />
                  <Button x:Name="RemoveExclusionButton" Content="_Remove" Click="RemoveExclusion" Margin="6,0,0,0" />
                </StackPanel>
                <ListBox x:Name="ExcludedFolders" SelectionChanged="UpdateSelection" MinHeight="35" MaxHeight="85"
                         BorderBrush="{StaticResource Line}" AutomationProperties.Name="Excluded folders" />
              </DockPanel>
            </Expander>
          </StackPanel>
        </Border>

        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,13">
          <Border Style="{StaticResource MetricPanel}" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="Scanned size" Style="{StaticResource Caption}" FontSize="13" />
              <TextBlock x:Name="ScannedSize" Style="{StaticResource Metric}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource MetricPanel}" Margin="4,0,4,0">
            <StackPanel>
              <TextBlock Text="Observed change" Style="{StaticResource Caption}" FontSize="13" />
              <TextBlock x:Name="StorageDelta" Style="{StaticResource Metric}" Foreground="{StaticResource Green}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource MetricPanel}" Margin="8,0,0,0">
            <StackPanel>
              <TextBlock Text="Files scanned" Style="{StaticResource Caption}" FontSize="13" />
              <TextBlock x:Name="ScannedCount" Style="{StaticResource Metric}" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="1,1,1,6">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="12,9,12,5">
              <Button x:Name="RevealStorageButton" Content="Show in _Explorer" Click="RevealStorageFile" DockPanel.Dock="Right" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="ChangesTab" Content="Changes" GroupName="StorageResults" IsChecked="True" Style="{StaticResource ResultTab}" Click="ChangeResults" />
                <RadioButton x:Name="LargestTab" Content="Largest files" GroupName="StorageResults" Style="{StaticResource ResultTab}" Click="ChangeResults" />
              </StackPanel>
            </DockPanel>
            <TextBlock x:Name="StorageDetails" Grid.Row="1" Style="{StaticResource Caption}" FontSize="12" Margin="15,0,15,8" />
            <Grid Grid.Row="2">
              <DataGrid x:Name="StorageTable" SelectionChanged="UpdateSelection" AutomationProperties.Name="Storage scan results">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="*" MinWidth="140" ElementStyle="{StaticResource PathCell}" />
                  <DataGridTextColumn x:Name="BeforeColumn" Header="Before" Binding="{Binding Before}" Width="94" />
                  <DataGridTextColumn x:Name="AfterColumn" Header="After" Binding="{Binding After}" Width="94" />
                  <DataGridTextColumn x:Name="DeltaColumn" Header="Change" Binding="{Binding Delta}" Width="105" />
                  <DataGridTextColumn x:Name="SizeColumn" Header="Size" Binding="{Binding After}" Width="105" Visibility="Collapsed" />
                  <DataGridTextColumn x:Name="ModifiedColumn" Header="Last modified" Binding="{Binding Modified}" Width="145" Visibility="Collapsed" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="StorageEmpty" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                         VerticalAlignment="Center" TextAlignment="Center" Margin="18,38,18,0" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Grid x:Name="TemporaryPage" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
          <TextBlock Text="Temporary files" Style="{StaticResource Heading}" />
          <TextBlock Text="Review files created and last modified at least seven days ago." Style="{StaticResource Caption}" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="16,13" Margin="0,0,0,13">
          <DockPanel>
            <Button x:Name="ReviewButton" Content="_Find temporary files" Click="ScanTemporary" Style="{StaticResource Primary}"
                    DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
            <StackPanel>
              <TextBlock Text="Windows user temp folder" Style="{StaticResource Caption}" FontSize="12" />
              <TextBlock x:Name="TempPath" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="1,1,1,6">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="15,10,12,9">
              <Button x:Name="RevealTemporaryButton" Content="Show in _Explorer" Click="RevealTemporaryFile" DockPanel.Dock="Right" Margin="10,0,0,0" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TemporarySummary" FontWeight="SemiBold" />
                <TextBlock x:Name="TemporaryDetails" Style="{StaticResource Caption}" FontSize="12" />
              </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1">
              <DataGrid x:Name="TemporaryTable" SelectionChanged="UpdateSelection" AutomationProperties.Name="Temporary files for review">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="*" MinWidth="140" ElementStyle="{StaticResource PathCell}" />
                  <DataGridTextColumn Header="Size" Binding="{Binding After}" Width="105" />
                  <DataGridTextColumn Header="Last modified" Binding="{Binding Modified}" Width="145" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="TemporaryEmpty" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                         VerticalAlignment="Center" TextAlignment="Center" Margin="18,38,18,0" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <DockPanel Grid.Row="1" Margin="0,8,0,0" MinHeight="32">
        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="_Cancel scan" Click="CancelScan" Visibility="Collapsed" Margin="10,0,0,0" />
        <ProgressBar x:Name="WorkIndicator" DockPanel.Dock="Right" IsIndeterminate="True" Width="74" Height="4"
                     Foreground="{StaticResource Green}" Visibility="Collapsed" Margin="10,0,0,0" />
        <TextBlock x:Name="Status" Style="{StaticResource Caption}" VerticalAlignment="Center" FontSize="12"
                   AutomationProperties.LiveSetting="Polite" />
      </DockPanel>
    </Grid>
  </Grid>
</Window>
